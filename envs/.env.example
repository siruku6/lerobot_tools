# マシンごとに違う設定と、リポジトリに置けない秘密情報を書くファイルの雛形
#
# 使い方
# ------
#   cp envs/.env.example envs/.env     そのうえで値を埋める
#
# envs/.env は datactl.sh と compose の両方が読み、各サービスへ渡す。
# **envs/.env はリポジトリにコミットしない**（.gitignore に入っている）。
# このファイル（envs/.env.example）だけをコミットする。
#
# 環境に関する情報なので、他の環境構築物と同じ envs/ の下に置いている。
#
# 設定できているかは `./datactl.sh doctor` で確かめられる（API キーの中身は出ない）。


# ---------------------------------------------------------------------------
# wandb — 学習の経過の記録先
# ---------------------------------------------------------------------------
# wandb（Weights & Biases）は学習の loss や学習率などを web で見るための外部サービス。
# train image に wandb の python パッケージは既に入っているので、必要なのは値だけである。
#
# API キーの取り出し方: wandb にログインし、https://wandb.ai/authorize を開く。
# **これは秘密情報である。** このファイルの .env 側に書き、共有しない。
WANDB_API_KEY=

# 記録先のプロジェクト名。wandb の web で見えているプロジェクトの名前。
WANDB_PROJECT=

# チーム（organization）の名前。個人アカウントのプロジェクトなら空のままでよい。
WANDB_ENTITY=

# online / offline / disabled
#   online   … 学習しながら送る（既定）
#   offline  … 送らずに手元へ溜める。後から `wandb sync <dir>` で送る
#   disabled … 何も記録しない
WANDB_MODE=online


# ---------------------------------------------------------------------------
# jupyter — datagen image で立てる notebook 環境
# ---------------------------------------------------------------------------
# `./datactl.sh up jupyter` で立ち上げ、
# http://127.0.0.1:${JUPYTER_PORT}/lab?token=${JUPYTER_TOKEN} を開く。
JUPYTER_PORT=5001

# **固定値なので、外部から届くところでは必ず変えること。**
JUPYTER_TOKEN=demo


# ---------------------------------------------------------------------------
# HuggingFace のキャッシュ
# ---------------------------------------------------------------------------
# 重みやデータセットの置き場。**数 GB から数十 GB になる。**
# コンテナと共有することで、コンテナを捨てても取り直さずに済む。
# 空のままならホストの ${HOME}/.cache/huggingface を使う。
#
# コンテナの中では /hf として見え、HF_HOME がそこを指す。/root 配下に置かないのは、
# datagen と train をホストのユーザーで動かしているため（root 以外は /root を辿れない）。
HF_CACHE_DIR=


# ---------------------------------------------------------------------------
# データの置き場
# ---------------------------------------------------------------------------
# **データセット・重み・チェックポイントは image にもコンテナにも入れない。**
# すべてここで指定したホスト側のディレクトリを bind mount して読み書きする。
# 相対パスは envs/ から解決される（compose.yaml と同じ場所が基準）。
# 大きくなるので、容量に余裕のあるディスク上のパスを絶対パスで書いてもよい。

# コンテナで /data として見える。自分で用意したデータセットなどを置く。
DATA_DIR=../data

# コンテナで /outputs として見える。学習の出力（チェックポイント、
# wandb の作業ファイル）が書かれる。**1 回の学習で数 GB になりうる。**
OUTPUT_DIR=../outputs

# コンテナで /datasets として見える。**読み取り専用でマウントされる。**
# すでに手元にある LeRobot 形式データセットの置き場を指す。学習には
# --dataset-root /datasets/<名前> の形で渡す。
# 例: /home/ubuntu/src/PARC2026_pre/work/artifacts
DATASETS_DIR=../data

# eval コンテナで /reference として見える。**読み取り専用でマウントされる。**
# 移行元のリポジトリ（PARC2026_pre）を指す。評価の採点処理をこのリポジトリへ
# 写さず、原本をそのまま動かすために使う。
REFERENCE_REPO=../../PARC2026_pre
