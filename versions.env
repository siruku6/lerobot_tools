# LIBERO / LIBERO-plus のコミット、torch 系、lerobot、評価用ライブラリ群の
# バージョンの値をこのファイルで管理する。バージョンはこのファイルに集約する。
#
# docker build の各 step も Dockerfile も、ここの値を環境変数か --build-arg で受け取る。

# ---------------------------------------------------------------- LIBERO
# PARC2026 コンペティションで採点に使われた Docker イメージが
# submodule で固定している commit hash
LIBERO_PLUS_REF=4976dc30028e805ff8094b55501d532c48fec182
LIBERO_REF=8f1084e3132a39270c3a13ebe37270a43ece2a01

# LIBERO-plus が「背景テクスチャ」「照明」の摂動評価に使う追加アセットを固定するための
# commit hash
# （通常の LIBERO には無い、新規オブジェクト・テクスチャ画像・MuJoCo シーン定義）
# 展開後 9.5GB / zip 6.4GB。
ASSETS_REV=dd2bd61b7d9a6fef1abc52d606e983b41886a149

# ---------------------------------------------------------------- torch 系
# torch / torchcodec / torchvision と、評価用/学習用の CUDA index
# （TORCH_INDEX_EVAL / TORCH_INDEX_TRAIN）は対で決める。
# 経緯・組み合わせを崩してはいけない理由は docs/ADR/0001-torch-stack-pinning.md 参照。
TORCH_VERSION=2.11.0
TORCHCODEC_VERSION=0.11.1
TORCHVISION_VERSION=0.26.0

TORCH_INDEX_EVAL=https://download.pytorch.org/whl/cu130
TORCH_INDEX_TRAIN=https://download.pytorch.org/whl/cu128

# ---------------------------------------------------------------- lerobot
# LEROBOT_TAG は学習・データセット構築（dataset イメージの venv-lerobot）専用。
#
# 評価用の lerobot バージョンはこれとは別で、採点イメージは 0.4.4 を要求する
# （理由不明）。評価イメージはまだ実装されておらず、評価用の変数はまだこの
# ファイルに無い。
LEROBOT_TAG=v0.6.0

# ---------------------------------------------------------------- 評価側の pin
# NUMPY_VERSION を上げてはいけない理由は docs/ADR/0002-numpy-pin-for-libero.md 参照。
NUMPY_VERSION=1.26.4
MUJOCO_VERSION=3.7.0
ROBOSUITE_VERSION=1.4.0
BDDL_VERSION=3.6.0
GYM_VERSION=0.25.2
