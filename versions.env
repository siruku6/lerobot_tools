# データイメージの中身を決める git の ref
#
# Usage
# ------
#   set -a; . versions.env; set +a
#   ./datactl.sh tag        # ここから libero-data のタグが決まる
#
# Effect
# ------
# datactl.sh がこの 3 つからデータイメージのタグを組み立てる。
# ref を変えれば別のタグになり、古いイメージはそのまま残る。
#
#
# なぜここに python のパッケージ版を書かないのか
# ------
# 版は環境ごとに違うからである。同じ numpy でも datagen と eval は 1.26.4、
# train は 2.2.6 を使う。torch の index も eval / datagen は cu130、
# train は cu128 である。
#
# 共通でないものを共通の場所に置くと、NUMPY_VERSION_DATAGEN のような
# 名前が増えていき、どれがどこで使われるのか分からなくなる。
# **版はそれを使う環境の依存定義ファイルに書く。**
#
#   envs/eval/requirements.txt     採点環境と同じく pip で入れる
#   envs/datagen/pyproject.toml    uv で入れる
#   envs/train/pyproject.toml      uv で入れる
#
# ここに残っている 3 つは python のパッケージ版ではない。git の ref であり、
# pyproject では表現できず、タグの計算にも使われる。

# LIBERO-plus 本体（bddl_files と、配布データの読み出し）
LIBERO_PLUS_REF=4976dc30028e805ff8094b55501d532c48fec182

# LIBERO 本体（assets の取得元）
LIBERO_REF=8f1084e3132a39270c3a13ebe37270a43ece2a01

# assets の版（LIBERO 本体とは別に動く）
ASSETS_REV=dd2bd61b7d9a6fef1abc52d606e983b41886a149
